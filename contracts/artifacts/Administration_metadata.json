		"devdoc": {
			"details": "Contract manages event information throught out all supoorted network. Contract deploys a network admin didicated to each network adn stores the network specific data on the network admin contracts. Contract also manages all the admin functions that mainly includes manipulating sensitive data of an event such as the receiving address by the user. All admin interactions require the event owner to sign required data and call the contract through the orgnaizations private key to enable gassless transactions. Contract also records all the contributions received and realted fees. Last and the main functionality of the contract is handling NFT rewards that includes intiating new instances, minting and managing ownership through out the lifetime of the event. All the mutations restricted for the Creator is done by the governer.",
			"kind": "dev",
			"methods": {
				"addCollectionFactory(address)": {
					"details": "Function to add the custom NFT factory address."
				},
				"addNetwork(uint256)": {
					"details": "Adding new network support by deploying a network admin specific to the  new network intended to supoort."
				},
				"addPublicCollectionAddress(address)": {
					"details": "Function to add the public NFT collection address after minting the contract."
				},
				"changeFeeFactor(uint256)": {
					"details": "Funtion for changing the fee factor."
				},
				"changeGoverner(address)": {
					"details": "restricted function to change governer address."
				},
				"changeOrg(address)": {
					"details": "restricted function to change organization address."
				},
				"changeReceiver(address,string,uint256,address,uint256,uint256,bytes)": {
					"details": "Funtion to change the receiver of an event specific to the network."
				},
				"close(string,address,uint256,uint256,bytes,address)": {
					"details": "Function close an event NOTE: ONCE CLOSED AN EVENT CANNOT BE RE-OPENED"
				},
				"createCustomCollection(address,uint256,string,string,string)": {
					"details": "Function mints a new custom NFT collection for event rewards."
				},
				"createEvent(address,(uint256,address)[])": {
					"details": "Events are created by assigning an event id.",
					"params": {
						"chainData": "Array of ChainData. Creator must atleast select one supported network to create an event.",
						"owner": "Address of the event owner. Only owner can manipulate the event data by calling the contract through the organization private key."
					}
				},
				"joinPublicCollection(uint256,string)": {
					"details": "Funtion initiate event rewards in the public collection."
				},
				"mintCustom(address,uint256)": {
					"details": "Function to mint an NFT on be-half of the contributor from the dedicated collection for the event."
				},
				"mintPublic(address,uint256)": {
					"details": "Funtion to mint an NFT on be-half of the contributor from the public collection for event rewards."
				},
				"recordNativeContribution(uint256,uint256,uint256)": {
					"details": "Recording received native contributions."
				},
				"recordTokenContribution(uint256,uint256,uint256,address)": {
					"details": "Recording received native contributions."
				},
				"transferAuthority(address,string,address,uint256,uint256,bytes)": {
					"details": "Function to transfer ownership of an event"
				}
			},
			"stateVariables": {
				"adminTypeHash": {
					"details": "Typehash of the structs to be used in the validation process mentioned above."
				},
				"closed": {
					"details": "Keeps in track of the closed and opened state of an event."
				},
				"customCollections": {
					"details": "Keeps in-track of the custom NFT contracts created by the events for rewards."
				},
				"eventCounter": {
					"details": "Event ids are assigned by a incremented state variable. "
				},
				"factory": {
					"details": "Address of the Custom NFT Factory."
				},
				"feeFactor": {
					"details": "Method used to calculate the fee When the amount is devided by the fee factor, the quotient will be the fee. example: If the fee is 1%, feeFactor will be 100."
				},
				"governer": {
					"details": "Address of the governer."
				},
				"isExpired": {
					"details": "Keeps intrack of the processed transactions."
				},
				"networkAdmins": {
					"details": "Keeps in-track of the network admins. Description available in the networkAdmin contract description."
				},
				"org": {
					"details": "Address of the oragainzation."
				},
				"owners": {
					"details": "Records the owners of the event."
				},
				"publicCollectionAddress": {
					"details": "Address of the public NFT collection for event Rewards."
				}
			},
			"version": 1
		},
